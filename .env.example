# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where enquiries are delivered. Comma-separate for multiple recipients.
ENQUIRY_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend, e.g. "Bobby Group Website <enquiries@yourdomain>".
# For quick testing before verifying a domain, Resend allows: onboarding@resend.dev
ENQUIRY_FROM_EMAIL=

# Public site URL, used for canonical links, Open Graph, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://bobbygroup.in
